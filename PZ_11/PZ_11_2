#Из заданной строки отобразить только символы пунктуации. Использовать библиотеку string.
import string
s = 'TheGreatPyramidofKhufuatGizawasbuiltabout 2700 BC, 755 feet (230meters) longand 481 feet (147 metres) high '
punctuation_chars = [char for char in s if char in string.punctuation]
result_string = ''
for char in punctuation_chars:
    result_string = result_string + char
print("Строка только из символов пунктуации:", result_string)
